#!/usr/bin/env python3
"""Shop Master: one shopping list priced across delivery platforms, fees included.

A run moves through four commands: `where` fixes the delivery point, `gather` collects the stores, their fee rules and their candidate products for each wanted item, `pick` corrects which candidate stands for an item at a store (`drop` removes a store that does not belong), and `solve` ranks the ways to buy the list. `login` signs in to a platform so that it is read as the shopper's own account.
"""

import argparse
import getpass
import json
import os
import re
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
from math import floor
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import bolt  # noqa: E402
import glovo  # noqa: E402
import solver  # noqa: E402
import units  # noqa: E402
import wolt  # noqa: E402

PLATFORMS = {"wolt": wolt, "glovo": glovo, "bolt": bolt}
POINT_FILE = Path.home() / ".config" / "shop-master" / "point.json"
RUN_FILE = Path.home() / ".cache" / "shop-master" / "run.json"
ACCOUNTS_FILE = Path.home() / ".config" / "shop-master" / "accounts.json"
SAMPLE_BASKETS = (1000, 2500, 5000, 10000)
CANDIDATES = 8   # products kept per item and store
ALSO_LISTED = 6  # stores named after the chosen ones, for adding by hand
ROUNDS = 3       # times a closed or unreadable store is replaced by the next in the ranking


def money(amount):
    return f"{amount / 100:.2f}"


def now():
    return datetime.now().astimezone().isoformat(timespec="minutes")


def load(path, what):
    if not path.exists():
        sys.exit(f"No {what} yet ({path} is missing).")
    return json.loads(path.read_text())


def save(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=1))


def attempt(function, *args):
    """Run one lookup, returning (result, None) or (None, reason).

    A lookup that failed says nothing about what the store stocks, so the reason is kept and shown apart from "nothing found".
    """
    try:
        return function(*args), None
    except Exception as error:  # every failure of a remote lookup is reported the same way
        return None, str(error) if isinstance(error, RuntimeError) else f"{type(error).__name__}: {error}"


# --- accounts --------------------------------------------------------------

def load_accounts():
    return json.loads(ACCOUNTS_FILE.read_text()) if ACCOUNTS_FILE.exists() else {}


def save_accounts(accounts):
    """Keep the sign-in tokens. They act for the shopper's accounts, so the file is the owner's alone to read, and it is replaced whole: a token half written is a sign-in lost."""
    ACCOUNTS_FILE.parent.mkdir(parents=True, exist_ok=True)
    fresh = ACCOUNTS_FILE.with_suffix(".new")
    with os.fdopen(os.open(fresh, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as handle:
        json.dump(accounts, handle, indent=1)
    os.replace(fresh, ACCOUNTS_FILE)


def describe_account(platform, session, point):
    found, error = attempt(PLATFORMS[platform].whoami, session, point["lat"], point["lon"])
    if error:
        return f"{platform.title()}: signed in, but the account could not be read ({error})"
    return f"{platform.title()}: signed in as {found['who']}; {found['plan']}: {'yes' if found['member'] else 'no'}"


def login(args):
    point = load(POINT_FILE, "delivery point")
    accounts = load_accounts()
    try:
        session = PLATFORMS[args.platform].sign_in(lambda prompt, secret=False: getpass.getpass(prompt) if secret else input(prompt),
                                                   print, point["lat"], point["lon"])
    except RuntimeError as refusal:
        said = getattr(refusal, "reply", None)
        sys.exit(f"Not signed in. {refusal}" + (f"\n{args.platform.title()} said: {said}" if said else ""))
    accounts[args.platform] = PLATFORMS[args.platform].ACCOUNT = session
    save_accounts(accounts)
    print(f"Signed in. The token is kept in {ACCOUNTS_FILE}, which only you can read; `logout {args.platform}` removes it.")
    print(describe_account(args.platform, session, point))


def logout(args):
    accounts = load_accounts()
    session = accounts.pop(args.platform, None)
    if not session:
        sys.exit(f"Not signed in to {args.platform.title()}.")
    save_accounts(accounts)
    module, point = PLATFORMS[args.platform], load(POINT_FILE, "delivery point")
    _, error = attempt(module.sign_out, session, point["lat"], point["lon"]) if hasattr(module, "sign_out") else (None, None)
    print(f"Signed out of {args.platform.title()}; its token is removed from this computer."
          + (f" Telling {args.platform.title()} to end the session failed ({error}), so end it in the app if that matters." if error else ""))


def account(args):
    point, accounts = load(POINT_FILE, "delivery point"), load_accounts()
    for platform in PLATFORMS:
        print(describe_account(platform, accounts[platform], point) if platform in accounts else f"{platform.title()}: not signed in")


# --- where -----------------------------------------------------------------

def where(args):
    if args.lat is None:
        point = load(POINT_FILE, "delivery point")
        print(f"{point['lat']}, {point['lon']}  {point['label']}")
        return
    if args.lon is None:
        sys.exit("Give both latitude and longitude.")
    save(POINT_FILE, {"lat": args.lat, "lon": args.lon, "label": " ".join(args.label)})
    print(f"Delivery point saved to {POINT_FILE}")


# --- the list --------------------------------------------------------------

def parse_want(spec):
    """'eggs*2=eggs|კვერცხი' -> ('eggs', {'count': 2, 'queries': ['eggs', 'კვერცხი']}); 'milk*2l=milk' -> ('milk', {'amount': [2000, 'ml'], ...})"""
    left, _, queries = spec.partition("=")
    key, _, quantity = (part.strip() for part in left.partition("*"))
    if not re.fullmatch(r"[\w-]+", key):
        sys.exit(f"{spec}: an item's key is one plain word, such as 'milk' or 'black-pepper'.")
    want = {"queries": [query.strip() for query in (queries or key).split("|") if query.strip()]}
    amount = units.measure(quantity)
    if not quantity:
        want["count"] = 1
    elif quantity.isdigit() and int(quantity) > 0:
        want["count"] = int(quantity)
    elif amount and units.SIZE.fullmatch(quantity):
        want["amount"] = amount
    else:
        sys.exit(f"{spec}: after * give a number of packs (eggs*2) or an amount with its unit (eggs*20pc, milk*2l, rice*1kg, cheese*300g).")
    return key, want


def show_size(size):
    amount, unit = size
    if unit != "pc" and amount >= 1000:
        amount, unit = amount / 1000, {"g": "kg", "ml": "l"}[unit]
    return f"{amount:g} {unit}"


def standing(run, ref, key):
    """The candidate standing for an item at a store and how many of it to buy, as (offer, count), or None when none stands.

    Left to itself the platform's first match stands. Where the shopper asked for an amount, it is the first match whose pack size can be compared with that amount: a pack of unknown size could be anything from one egg to thirty.
    """
    offers = run["stores"][ref]["offers"].get(key)
    if not offers:
        return None
    pick, want = run["picks"].get(f"{ref}.{key}"), run["wants"][key]
    if pick is None:
        if "amount" not in want:
            return offers[0], want["count"]
        return next(((offer, count) for offer in offers if (count := units.packs(want["amount"], offer.get("size")))), None)
    if pick["n"] is None:
        return None
    offer = offers[pick["n"] - 1]
    count = pick.get("count") or (units.packs(want["amount"], offer.get("size")) if "amount" in want else want["count"])
    return (offer, count) if count else None


def amounts(offer, count):
    """What `count` units of a candidate cost, and what they would cost without discounts."""
    paid = offer["price"] * count
    if offer.get("bulk") and count >= offer["bulk"][0]:
        paid -= floor(paid * offer["bulk"][1] + 0.5)
    return paid, max(paid, offer.get("list", offer["price"]) * count)


# --- gather ----------------------------------------------------------------

def rank(seen, platform):
    """One platform's stores by how much of the list they matched, the cheaper match first among equals."""
    return sorted(((store, found) for (name, store), found in seen.items() if name == platform),
                  key=lambda entry: (-len(entry[1]), sum(entry[1].values())))


def gather(args):
    point = load(POINT_FILE, "delivery point")
    lat, lon = point["lat"], point["lon"]
    if args.add:
        run = load(RUN_FILE, "run to add to")
        if run["point"] != point:
            sys.exit("The delivery point has changed since this run was gathered, and its stores carry the old point's fees. Gather afresh.")
        run["extended"] = now()
    else:
        run = {"at": now(), "point": point, "food": args.food, "wants": {}, "stores": {}, "picks": {}, "unread": {}, "issued": {}}
    food = run["food"]
    fresh_wants = []
    for spec in args.want:
        key, want = parse_want(spec)
        if run["wants"].get(key, {}).get("queries") != want["queries"]:
            # An item searched afresh loses what the old queries found, and the picks made among it.
            for ref, store in run["stores"].items():
                store["offers"].pop(key, None)
                run["picks"].pop(f"{ref}.{key}", None)
            fresh_wants.append(key)
        run["wants"][key] = want
    if not run["wants"]:
        sys.exit("Nothing wanted: pass at least one --want.")
    platforms = args.platform.split(",") if args.platform else list(PLATFORMS)
    named = [tuple(spec.split(":", 1)) for spec in [*args.store, *run["unread"]]]
    for platform in [*platforms, *(spec[0] for spec in named)]:
        if platform not in PLATFORMS:
            sys.exit(f"{platform}: not a platform. Use one of {', '.join(PLATFORMS)}, and name a store as platform:key.")
    if any(len(spec) != 2 for spec in named):
        sys.exit("Name a store as platform:key, for example wolt:spar-amaghleba.")
    problems, also = [], []
    pool = ThreadPoolExecutor(6)

    def read(platform, key):
        """Read one store into the run. Returns the record, or None when it could not be read (which the run remembers)."""
        record, error = attempt(PLATFORMS[platform].store, key, lat, lon)
        spec = f"{platform}:{key}"
        if error:
            run["unread"][spec] = error
            return None
        run["unread"].pop(spec, None)
        return record

    def admit(platform, key, record):
        run["issued"][platform] = run["issued"].get(platform, 0) + 1
        run["stores"][f"{platform[0]}{run['issued'][platform]}"] = {"platform": platform, "key": key, **record, "offers": {}, "failed": {}}

    held = {(store["platform"], store["key"]) for store in run["stores"].values()}
    wanted = [spec for spec in dict.fromkeys(named) if spec not in held]
    for (platform, key), record in zip(wanted, pool.map(lambda spec: read(*spec), wanted)):
        if record:
            admit(platform, key, record)
            held.add((platform, key))

    # Cross-store search shows which stores carry the most of the list; those are the ones worth reading closely.
    searched = list(run["wants"]) if not args.add else fresh_wants
    tasks = [(platform, key, query) for platform in platforms for key in searched for query in run["wants"][key]["queries"]]
    seen, names = {}, {}
    for (platform, key, query), (hits, error) in zip(tasks, pool.map(lambda task: attempt(PLATFORMS[task[0]].discover, task[2], lat, lon, food), tasks)):
        if error:
            problems.append(f"{platform}: cross-store search for {query!r} failed ({error})")
            continue
        for hit in hits:
            if hit["open"] is False and not args.closed:
                continue
            names[platform, hit["store"]] = hit["name"]
            cheapest = seen.setdefault((platform, hit["store"]), {})
            cheapest[key] = min(cheapest.get(key, hit["price"]), hit["price"])

    rankings = {platform: rank(seen, platform) for platform in platforms}
    tried = set(held)

    def fill(needs):
        """Read stores until each need is met: None asks for the next store in a platform's ranking, an item's key for the next that matched it.

        A store that turns out closed or unreadable leaves its need open, and the next round reads the one after it.
        """
        for _ in range(ROUNDS):
            batch = []
            for platform, need in needs:
                store = next((store for store, found in rankings[platform]
                              if (platform, store) not in tried and (need is None or need in found)), None)
                if store:
                    tried.add((platform, store))
                    batch.append((platform, need, store))
            if not batch:
                break
            for (platform, need, store), record in zip(batch, pool.map(lambda entry: read(entry[0], entry[2]), batch)):
                if record and (record["open"] or args.closed):
                    admit(platform, store, record)
                    needs.remove((platform, need))
                elif record:
                    problems.append(f"{platform}: {record['name']} is closed ({record['opens']}) and was passed over; --closed keeps such stores")

    if not args.add:
        fill([(platform, None) for platform in platforms for _ in range(args.per_platform)])
        for platform in platforms:
            if not rankings[platform]:
                problems.append(f"{platform}: no {'restaurant' if food else 'store'} matched any of the list")
    # Whatever the stores read so far did not match gets a store of its own: a list of several kinds seldom fits the stores that match most of it.
    uncovered = []
    for platform in platforms:
        matched = set().union(*(seen.get((platform, store["key"]), {}) for store in run["stores"].values() if store["platform"] == platform))
        uncovered += [(platform, key) for key in searched if key not in matched and any(key in found for _, found in rankings[platform])]
    fill(uncovered)
    for platform in platforms:
        others = [f"{platform}:{store} {names[platform, store]} ({len(found)}/{len(searched)})"
                  for store, found in rankings[platform] if (platform, store) not in tried][:ALSO_LISTED]
        if others:
            also.append(f"{platform} also matched: " + "; ".join(others))

    def stock(pair):
        ref, key = pair
        store = run["stores"][ref]
        found, errors = [], []
        for query in run["wants"][key]["queries"]:
            offers, error = attempt(PLATFORMS[store["platform"]].shelf, store, query, lat, lon)
            if error:
                errors.append(error)
            found.append(offers or [])
        # The queries take turns, so that one with many matches does not crowd the others out of the few kept.
        merged = {}
        for position in range(max(map(len, found), default=0)):
            for offers in found:
                if position < len(offers):
                    merged.setdefault(offers[position]["id"], offers[position])
        return list(merged.values())[:CANDIDATES], errors

    pairs = [(ref, key) for ref, store in run["stores"].items() for key in run["wants"]
             if key not in store["offers"] or key in store["failed"]]
    for (ref, key), (offers, errors) in zip(pairs, pool.map(stock, pairs)):
        store = run["stores"][ref]
        if store["offers"].get(key) != offers:
            run["picks"].pop(f"{ref}.{key}", None)  # a pick is a place in the list of candidates, which has changed
        store["offers"][key] = offers
        store["failed"].pop(key, None)
        if errors:
            store["failed"][key] = errors[0]
    pool.shutdown()

    save(RUN_FILE, run)
    show_run(run)
    print()
    for line in also:
        print(line)
    for problem in problems:
        print(f"! {problem}")
    show_gaps(run)


# --- show ------------------------------------------------------------------

def describe_offer(offer):
    parts = [offer["name"]]
    if offer.get("weighed"):
        parts.append(f"[by weight, {show_size(offer['size'])} a step]")
    elif offer.get("size"):
        parts.append(f"[{show_size(offer['size'])}]")
    price = ("from " if offer.get("from") else "") + money(offer["price"])
    each = units.per_unit(offer["price"], offer.get("size"))
    if each and offer.get("size") != [1, "pc"]:
        price += f" ({money(each[0])}/{each[1]})"
    if offer.get("list", offer["price"]) > offer["price"]:
        price += f", was {money(offer['list'])}"
    if offer.get("bulk"):
        price += f", {offer['bulk'][1]:.0%} off from {offer['bulk'][0]} units"
    parts.append(price)
    if offer.get("from"):
        parts.append("has choices that can add to the price")
    if offer.get("stock") is not None:
        parts.append(f"stock {offer['stock']}")
    return "  ".join(parts)


def describe_store(store):
    parts = [f"{store['platform'].title()} · {store['name']}"]
    parts.append("open" if store["open"] else "CLOSED" + (f" ({store['opens']})" if store.get("opens") else ""))
    parts += [store[field] for field in ("eta", "distance") if store.get(field)]
    if store.get("rating"):
        parts.append(f"rating {store['rating']}")
    return " · ".join(parts)


def describe_run(run):
    when = f"gathered {run['at']}" + (f", extended {run['extended']}" if run.get("extended") else "")
    return f"Run {when} for {run['point']['label'] or 'the saved point'}"


def show_run(run, only=None):
    print(f"{describe_run(run)} ({'restaurants' if run['food'] else 'stores'})")
    asked = [f"{key} ({show_size(want['amount'])})" if "amount" in want else f"{key} ×{want['count']}" if want["count"] != 1 else key
             for key, want in run["wants"].items()]
    print("List: " + ", ".join(asked))
    width = max(len(key) for key in run["wants"])
    for ref, store in run["stores"].items():
        if only and ref != only:
            continue
        print(f"\n{ref}  {describe_store(store)}")
        print(f"    {store['url']}")
        samples = "  ".join(f"{money(basket)}→{money(solver.fee_total(store, basket))}" for basket in SAMPLE_BASKETS)
        print(f"    fees ({', '.join(fee['label'] for fee in store['fees'])}) by basket: {samples}")
        if store.get("caveat"):
            print(f"    caveat: {store['caveat']}")
        for note in store.get("notes", []):
            print(f"    {note}")
        for key, want in run["wants"].items():
            label = key.ljust(width)
            offers = store["offers"].get(key, [])
            if not offers:
                print(f"    {label}  {'?  lookup failed, so unknown' if key in store['failed'] else '-  nothing found'}")
                continue
            chosen = standing(run, ref, key)
            for number, offer in enumerate(offers, 1):
                stands = bool(chosen) and chosen[0] is offer
                if stands:
                    count = f"  → ×{chosen[1]}" if chosen[1] != 1 or "amount" in want else ""
                elif "amount" in want:
                    packs = units.packs(want["amount"], offer.get("size"))
                    count = f"  → ×{packs}" if packs else "  → size unknown"
                else:
                    count = ""
                print(f"    {label if number == 1 else ' ' * width} {'*' if stands else ' '}{number}  {describe_offer(offer)}{count}")
                if run["food"] and offer.get("note"):
                    print(f"    {' ' * width}     {offer['note'][:220]}")
            if not chosen and f"{ref}.{key}" in run["picks"]:
                print(f"    {' ' * width}     (dropped: no candidate stands for this item here)")
            elif not chosen:
                print(f"    {' ' * width}     (none stands: no pack size here compares with the amount asked; pick one with its number, as in {ref}.{key}=1x2)")


def show_gaps(run):
    """What the run could not establish. Each line is something unknown, not something absent."""
    for spec, reason in run["unread"].items():
        print(f"! {spec}: the store could not be read ({reason}). `gather --add` tries again.")
    for ref, store in run["stores"].items():
        for key, reason in store["failed"].items():
            print(f"! {ref} {key}: a lookup failed, so the candidates may be incomplete ({reason}). `gather --add` tries again.")


def show(args):
    run = load(RUN_FILE, "run")
    show_run(run, args.ref)
    show_gaps(run)


# --- pick ------------------------------------------------------------------

def pick(args):
    run = load(RUN_FILE, "run")
    for spec in args.picks:
        target, _, choice = spec.partition("=")
        ref, _, key = target.partition(".")
        offers = run["stores"].get(ref, {}).get("offers", {}).get(key)
        if not offers:
            sys.exit(f"{target}: no candidates there to pick from.")
        if choice == "-":
            run["picks"][target] = {"n": None}
            continue
        number, _, count = choice.partition("x")
        if not number.isdigit() or not 1 <= int(number) <= len(offers):
            sys.exit(f"{spec}: candidate numbers at {target} run from 1 to {len(offers)}.")
        if count and not (count.isdigit() and int(count) > 0):
            sys.exit(f"{spec}: after x give how many to buy, a whole number of at least 1.")
        want = run["wants"][key]
        if not count and "amount" in want and not units.packs(want["amount"], offers[int(number) - 1].get("size")):
            sys.exit(f"{spec}: that candidate's pack size is unknown, so say how many to buy, as in {target}={number}x2.")
        run["picks"][target] = {"n": int(number), **({"count": int(count)} if count else {})}
    save(RUN_FILE, run)
    print(f"{len(args.picks)} pick(s) saved.")


def drop(args):
    run = load(RUN_FILE, "run")
    for ref in args.refs:
        if ref not in run["stores"]:
            sys.exit(f"{ref}: no such store in the run.")
        del run["stores"][ref]
        run["picks"] = {target: choice for target, choice in run["picks"].items() if not target.startswith(f"{ref}.")}
    save(RUN_FILE, run)
    print(f"{len(args.refs)} store(s) dropped.")


# --- solve -----------------------------------------------------------------

def price_exactly(run, plan, lines, quotes):
    """Replace a plan's planning fees with the platform's own pricing wherever the platform prices a basket for us."""
    for basket in plan["baskets"]:
        store = run["stores"][basket["ref"]]
        module = PLATFORMS[store["platform"]]
        basket["basis"] = "partial" if store.get("partial") else "estimated" if store.get("caveat") else "planned"
        if not hasattr(module, "quote"):
            continue
        key = (basket["ref"], tuple(basket["wants"]))
        if key not in quotes:
            quotes[key] = attempt(module.quote, store, [lines[basket["ref"], want] for want in basket["wants"]],
                                  run["point"]["lat"], run["point"]["lon"])
        priced, error = quotes[key]
        if error:
            basket["quote_error"] = error
            continue
        basket["fees"], basket["basis"] = list(priced["fees"]), "priced"
        if priced["goods"] not in (None, basket["subtotal"]):
            # The platform charges the goods differently from the shelf prices added up: offers that depend on what else is in the basket.
            label = "Offers: " + "; ".join(priced["offers"]) if priced["offers"] else "Goods as priced by the platform"
            basket["fees"].insert(0, (label, priced["goods"] - basket["subtotal"]))
        basket["total"] = basket["subtotal"] + sum(amount for _, amount in basket["fees"])
    plan["total"] = sum(basket["total"] for basket in plan["baskets"])


def solve(args):
    run = load(RUN_FILE, "run")
    stores, lines, skipped = [], {}, []
    for ref, store in run["stores"].items():
        if not store["open"] and not args.closed:
            skipped.append(f"{ref} {store['name']} is closed")
            continue
        amounts_here = {}
        for key in run["wants"]:
            chosen = standing(run, ref, key)
            if chosen:
                lines[ref, key] = chosen
                amounts_here[key] = amounts(chosen[0], chosen[1])
        if amounts_here:
            stores.append({"ref": ref, "fees": store["fees"], "lines": amounts_here})

    ranked = solver.plans(list(run["wants"]), stores, args.max_stores)
    if not ranked:
        sys.exit("No open store in the run has any of the wanted items.")
    listed = ranked[: args.top]
    extras = {
        "Best single order": next((plan for plan in ranked if len(plan["baskets"]) == 1), None),
        # A store whose fees are partly hidden looks cheaper than it is, so the best plan free of such stores is always shown beside the rest.
        "Best with every fee known": next((plan for plan in ranked
                                           if not any(run["stores"][basket["ref"]].get("partial") for basket in plan["baskets"])), None),
    }
    for plan in extras.values():
        if plan and plan not in listed:
            listed.append(plan)
    quotes = {}
    for plan in listed:
        price_exactly(run, plan, lines, quotes)
    listed.sort(key=lambda plan: (len(plan["missing"]), plan["total"]))

    currency = next((store["currency"] for store in run["stores"].values() if store.get("currency")), "")
    print(f"{describe_run(run)}; amounts in {currency}")
    for position, plan in enumerate(listed, 1):
        orders = len(plan["baskets"])
        bases = {basket["basis"] for basket in plan["baskets"]}
        total = money(plan["total"])
        total = f"at least {total}" if "partial" in bases else f"about {total}" if bases - {"priced"} else total
        covered = "everything covered" if not plan["missing"] else "WITHOUT " + ", ".join(plan["missing"])
        tags = [name.lower() for name, extra in extras.items() if extra is plan]
        note = (f"  [{'; '.join(tags)}]" if tags else "") + ("  (approximate: the search was cut short)" if plan["approximate"] else "")
        print(f"\n{position}. {total} in {orders} order{'s' if orders > 1 else ''}, {covered}{note}")
        for basket in plan["baskets"]:
            store = run["stores"][basket["ref"]]
            print(f"   {basket['ref']}  {describe_store(store)}")
            print(f"      {store['url']}")
            for key in basket["wants"]:
                offer, count = lines[basket["ref"], key]
                size = f" [{show_size(offer['size'])}]" if offer.get("size") else ""
                print(f"      {key}: {count} × {offer['name']}{size}  {money(amounts(offer, count)[0])}")
            fees = "".join(f" + {label} {money(amount)}" if amount >= 0 else f" − {label} {money(-amount)}" for label, amount in basket["fees"])
            mine = " for your account" if getattr(PLATFORMS[store["platform"]], "ACCOUNT", None) else ""
            basis = {"priced": f"priced by {store['platform'].title()}{mine}", "planned": "planning estimate",
                     "estimated": store.get("caveat"), "partial": store.get("caveat")}[basket["basis"]]
            print(f"      goods {money(basket['subtotal'])}{fees} = {money(basket['total'])}  ({basis})")
            if basket.get("quote_error"):
                print(f"      ! {store['platform'].title()} did not price this basket ({basket['quote_error']})")
            if basket["next_threshold"]:
                extra, saved = basket["next_threshold"]
                print(f"      {money(extra)} more goods here would cut the fees by {money(saved)}")

    for key in run["wants"]:
        if not any(key in store["lines"] for store in stores):
            print(f"\n! {key}: no open store in the run offers it.")
    show_gaps(run)
    for note in skipped:
        print(f"! left out: {note} (use --closed to plan with it)")


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    commands = parser.add_subparsers(dest="command", required=True)

    p = commands.add_parser("where", help="show the delivery point, or set it")
    p.add_argument("lat", nargs="?", type=float)
    p.add_argument("lon", nargs="?", type=float)
    p.add_argument("label", nargs="*", help="a name for the point, for the reports")
    p.set_defaults(run=where)

    p = commands.add_parser("gather", help="collect stores, fee rules and candidate products for the list")
    p.add_argument("--want", action="append", default=[], metavar="KEY[*HOW-MUCH]=QUERY[|QUERY]",
                   help="an item and what to search for; HOW-MUCH is a number of packs (eggs*2) or an amount with its unit (eggs*20pc, milk*2l, rice*1kg), from which the packs are counted; repeat per item")
    p.add_argument("--food", action="store_true", help="look at restaurants and their dishes instead of stores")
    p.add_argument("--store", action="append", default=[], metavar="PLATFORM:KEY", help="include this store whatever the search ranks")
    p.add_argument("--per-platform", type=int, default=3, help="stores taken from each platform's ranking (default 3); a store is added for any item those do not match")
    p.add_argument("--platform", help="comma-separated platforms to use (default: all)")
    p.add_argument("--closed", action="store_true", help="also take stores that are closed now")
    p.add_argument("--add", action="store_true", help="extend the current run with more items or stores, and retry what failed")
    p.set_defaults(run=gather)

    p = commands.add_parser("show", help="print the current run")
    p.add_argument("ref", nargs="?", help="only this store")
    p.set_defaults(run=show)

    p = commands.add_parser("pick", help="choose which candidate stands for an item at a store")
    p.add_argument("picks", nargs="+", metavar="REF.ITEM=N[xCOUNT]|-", help="e.g. w1.milk=2  g1.eggs=1x2 (candidate 1, two of it)  b1.rice=- (none fits)")
    p.set_defaults(run=pick)

    p = commands.add_parser("drop", help="remove stores from the run")
    p.add_argument("refs", nargs="+", metavar="REF")
    p.set_defaults(run=drop)

    p = commands.add_parser("solve", help="rank the ways to buy the list")
    p.add_argument("--max-stores", type=int, default=2, help="most orders a plan may use (default 2)")
    p.add_argument("--top", type=int, default=3, help="plans to print (default 3)")
    p.add_argument("--closed", action="store_true", help="plan with stores that are closed now")
    p.set_defaults(run=solve)

    p = commands.add_parser("login", help="sign in to a platform, so that prices and offers are your account's own")
    p.add_argument("platform", choices=list(PLATFORMS))
    p.set_defaults(run=login)

    p = commands.add_parser("logout", help="sign out of a platform and remove its token")
    p.add_argument("platform", choices=list(PLATFORMS))
    p.set_defaults(run=logout)

    p = commands.add_parser("account", help="show which platforms are signed in and whether each holds a subscription")
    p.set_defaults(run=account)

    args = parser.parse_args()
    accounts = load_accounts()
    for name, module in PLATFORMS.items():
        module.ACCOUNT = accounts.get(name)
        module.keep = lambda: save_accounts(accounts)
    args.run(args)


if __name__ == "__main__":
    main()
